{
  "name": "syntech-ticketing-be",
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "9"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "concurrently \"pnpm bot\" \"pnpm dev\"",
    "format": "prettier --write .",
    "knip": "knip",
    "validate": "eslint . && prettier --check . && tsc --noEmit && knip",
    "prepare": "husky",
    "bot": "tsx watch src/bot.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.2",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-validator": "^0.7.2",
    "@prisma/client": "6.14.0",
    "hono": "^4.9.2",
    "moment": "^2.30.1",
    "openai": "^5.12.2",
    "prisma-extension-pagination": "^0.7.5",
    "telegraf": "^4.16.3",
    "xior": "^0.7.8",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@commitlint/is-ignored": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "lint-staged": "^16.1.5",
    "openapi-types": "^12.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
