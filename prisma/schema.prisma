generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Whitelabel {
  id             String   @id @default(cuid())
  name           String
  whitelabelName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  issues         Issue[]

  @@map("white_labels")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]

  @@map("categories")
}

model Reporter {
  id        String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]

  @@map("reporters")
}

model Assignee {
  id        String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]

  @@map("assignees")
}

model Issue {
  id           String     @id @default(cuid())
  title        String
  description  String
  link         String
  status       Int        @default(1)
  whitelabelId String
  categoryId   String?
  reporterId   String
  assigneeId   String?
  priority     Int        @default(3)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  finishedAt   DateTime?
  assignee     Assignee?  @relation(fields: [assigneeId], references: [id])
  category     Category?  @relation(fields: [categoryId], references: [id])
  reporter     Reporter   @relation(fields: [reporterId], references: [id])
  whitelabel   Whitelabel @relation(fields: [whitelabelId], references: [id])

  @@map("issues")
}
